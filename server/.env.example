PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# All configuration lives here. There is no database — this file (and the
# equivalent Environment Variables in Vercel) is the single source of truth.
# Changing any value requires a restart locally, or a redeploy on Vercel.
# ---------------------------------------------------------------------------

# --- Google OAuth app (Google Cloud Console -> Credentials) ---
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:3000/api/auth/google-callback

# --- Google account access ---
# Long-lived token used to reach Sheets and Drive. Generate once by running
#   npm run connect-google
# then paste the printed value here and into Vercel. Treat it as a password:
# it grants ongoing access to the Drive and Sheets of the account that signed in.
GOOGLE_REFRESH_TOKEN=

# --- Destination ---
# Paste the whole URL; the ID is extracted automatically.
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/your-sheet-id/edit
# Optional. Leave blank to store signatures and photos in your Drive root.
GOOGLE_DRIVE_FOLDER_URL=

# --- Admin dashboard ---
# Required. Without it the admin API is disabled in production.
ADMIN_PASSWORD=choose-a-long-random-password
# Optional. Signs session tokens; change it to sign everyone out.
ADMIN_SESSION_SECRET=

# --- Frontend ---
# Comma-separated list is allowed, for Vercel preview deployments.
FRONTEND_URL=http://localhost:5173
